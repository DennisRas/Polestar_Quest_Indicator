{
  "$schema": "https://raw.githubusercontent.com/TradeSkillMaster/wowlua-ls/main/editors/vscode/wowluarc.schema.json",
  "addonRoot": true,
  "flavors": [
    "forever"
  ],
  "library": [
    "Debug/"
  ],
  "globals": {
    "read": [
      "Polestar",
      "QuestInfoRewardsFrameHeader"
    ]
  },
  "inference": {
    "implicitProtectedPrefix": true
  },
  "diagnostics": {
    "enable": [
      "need-check-nil",
      "unknown-param-type",
      "unknown-return-type",
      "unknown-local-type",
      "unknown-field-type"
    ]
  }
}
